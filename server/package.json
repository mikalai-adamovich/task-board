{
  "name": "@task-board/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:integration": "vitest run src/repositories/rate-limit-counter.repository.integration.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@task-board/shared": "*",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.5",
    "mongodb": "^7.6.0",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  }
}
