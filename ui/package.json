{
  "name": "@task-board/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "generate:themes": "node scripts/generate-theme-manifest.mjs",
    "prestart": "npm run generate:themes",
    "start": "ng serve",
    "prebuild": "npm run generate:themes",
    "build": "ng build",
    "pretest": "npm run generate:themes",
    "test": "ng test --no-watch",
    "pretest:verbose": "npm run generate:themes",
    "test:verbose": "ng test --no-watch --reporters=verbose",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "pree2e": "npm run generate:themes",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "analyze": "ng build --configuration production --stats-json && esbuild-visualizer --metadata dist/ui/stats.json --filename dist/ui/stats.html && xdg-open dist/ui/stats.html"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@jsverse/transloco": "^8.4.0",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/plugin-highlight": "^7.22.1",
    "@spartan-ng/brain": "^1.5.0",
    "@task-board/shared": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@ng-icons/core": "^35.1.0",
    "@ng-icons/lucide": "^35.1.0",
    "@playwright/test": "^1.63.0",
    "@spartan-ng/cli": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "^22.5.0",
    "esbuild-visualizer": "^0.7.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
