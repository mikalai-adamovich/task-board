{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"],
    "paths": {
      "@services/*": ["./src/app/services/*"],
      "@stores/*": ["./src/app/stores/*"],
      "@guards/*": ["./src/app/guards/*"],
      "@interceptors/*": ["./src/app/interceptors/*"],
      "@features/*": ["./src/app/features/*"],
      "@shell/*": ["./src/app/shell/*"],
      "@app/*": ["./src/app/*"],
      "@spartan-ng/helm/accordion": ["./libs/ui/accordion/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./libs/ui/avatar/src/index.ts"],
      "@spartan-ng/helm/badge": ["./libs/ui/badge/src/index.ts"],
      "@spartan-ng/helm/button": ["./libs/ui/button/src/index.ts"],
      "@spartan-ng/helm/card": ["./libs/ui/card/src/index.ts"],
      "@spartan-ng/helm/collapsible": ["./libs/ui/collapsible/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./libs/ui/dialog/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": ["./libs/ui/dropdown-menu/src/index.ts"],
      "@spartan-ng/helm/date-picker": ["./libs/ui/date-picker/src/index.ts"],
      "@spartan-ng/helm/calendar": ["./libs/ui/calendar/src/index.ts"],
      "@spartan-ng/helm/field": ["./libs/ui/field/src/index.ts"],
      "@spartan-ng/helm/input": ["./libs/ui/input/src/index.ts"],
      "@spartan-ng/helm/label": ["./libs/ui/label/src/index.ts"],
      "@spartan-ng/helm/native-select": ["./libs/ui/native-select/src/index.ts"],
      "@spartan-ng/helm/separator": ["./libs/ui/separator/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./libs/ui/sheet/src/index.ts"],
      "@spartan-ng/helm/sidebar": ["./libs/ui/sidebar/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./libs/ui/skeleton/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./libs/ui/spinner/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./libs/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./libs/ui/tooltip/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/ui/utils/src/index.ts"],
      "@spartan-ng/helm/table": ["./libs/ui/table/src/index.ts"],
      "@spartan-ng/helm/popover": ["./libs/ui/popover/src/index.ts"],
      "@spartan-ng/helm/pagination": ["./libs/ui/pagination/src/index.ts"],
      "@spartan-ng/helm/select": ["./libs/ui/select/src/index.ts"],
      "@spartan-ng/helm/sonner": ["./libs/ui/sonner/src/index.ts"],
      "@spartan-ng/helm/empty": ["./libs/ui/empty/src/index.ts"],
      "@spartan-ng/helm/alert": ["./libs/ui/alert/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./libs/ui/checkbox/src/index.ts"],
      "@spartan-ng/helm/switch": ["./libs/ui/switch/src/index.ts"],
      "@spartan-ng/helm/autocomplete": ["./libs/ui/autocomplete/src/index.ts"],
      "@spartan-ng/helm/input-group": ["./libs/ui/input-group/src/index.ts"],
      "@spartan-ng/helm/radio-group": ["./libs/ui/radio-group/src/index.ts"],
      "@spartan-ng/helm/sidebar/service": ["./libs/ui/sidebar/src/lib/hlm-sidebar.service.ts"],
      "lowlight": ["../node_modules/lowlight/lib/index.js"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "files": [],
  "include": ["src/**/*.ts", "libs/ui/**/src/**/*.ts", "../../shared/src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
