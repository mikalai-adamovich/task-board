# Dependencies
node_modules/

# TypeScript
*.tsbuildinfo
*.js.map
*.d.ts.map

# Build outputs
dist/
out/
.cache/

# Angular
.angular/
.ng/
ng-cli-output.log

# Environment
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Harness state: task contracts are tracked operator inputs; the other homes hold generated state.
.harness/state/runs/*
.harness/state/ledgers/*
.harness/state/reports/*
.harness/state/telemetry/*
.harness/state/control/*
# LEGACY: the runtime creates worktrees OUTSIDE the repository, so nothing writes this path any more. It stays
# ignored because `remove-workspace.sh` reports orphans left here and `harness workspace prepare` refuses to run
# while any exist — an unignored orphan would appear in `git status` and move `status_hash_pre/post`.
.harness/state/worktrees/
# Historical-workspace attestations (P1). Operator state, not evidence: gitignored so `git status --porcelain` does
# not start including it and `status_hash_pre/post` moves for unrelated reasons.
.harness/state/workspaces/
# Append-only trial/census log (`regress --repeat`, `census`). Operator state, not evidence: gitignored for the same
# reason as the attestations above, so `git status --porcelain` does not start including it and `status_hash_pre/post`
# moves for unrelated reasons.
.harness/state/regress-trials/

# Agent scratch: the single scratch home for throwaway analysis, probes, one-off scripts and Playwright's HTML report
# output. Never committed.
.agent-scratch/*
!.agent-scratch/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
# Playwright (`npm run test:e2e`): failure artifacts, the HTML report and the per-run traces.
ui/test-results/
playwright-report/
ui/.playwright/

# Playwright / e2e output (ui/e2e)
# Without these, every `npm run test:e2e` leaves a 500 KB+ generated HTML/JSON
# tree that is not code, gets picked up by `eslint .` (prettier/prettier) and
# inflates the warning count, and shows up as untracked noise in `git status`.
playwright-report/
blob-report/
test-results/
.playwright/

# OS
.DS_Store
Thumbs.db

# Wrangler (Cloudflare)
.wrangler/
.dev.vars

# Generated theme manifest (build artifact)
ui/public/themes/manifest.json

# Landing page research variants (standalone, not part of the app)
landings/
